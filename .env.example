# .env.example — modèle de configuration Tendia (copier en .env, remplir les clés)

# --- Clés API ---
ANTHROPIC_API_KEY=sk-ant-XXXXXXXX        # extraction LLM des briefs
TWOCAPTCHA_API_KEY=XXXXXXXX              # résolution captcha (downloaders DCE anonymes)

# --- Proxy résidentiel anti-ban ---
# URL du proxy (ex IPRoyal : http://user:pass@geo.iproyal.com:12321). Si absent,
# aucune session n'utilise de proxy.
TENDIA_PROXY_URL=http://user:pass@geo.iproyal.com:12321

# Proxy ciblé par plateforme : le proxy est ACTIVÉ par défaut pour TOUTES les
# plateformes (sécurité anti-ban). On le DÉSACTIVE explicitement (=0) seulement
# pour les plateformes confirmées sans ban. Format : TENDIA_PROXY_FOR_<PLATEFORME>=0
#   plateformes : place, dematis, aws_achat, achatpublic, atexo, boamp, data_gouv
TENDIA_PROXY_FOR_PLACE=0          # marches-publics.gouv.fr — confirmé sans ban
TENDIA_PROXY_FOR_DATA_GOUV=0      # data.gouv.fr (DECP) — open data, futur
TENDIA_PROXY_FOR_BOAMP=0          # BOAMP (avis) — diffusion officielle
# (Dematis / AWS-Achat / achatpublic / forks Atexo : proxy ON par défaut.)
